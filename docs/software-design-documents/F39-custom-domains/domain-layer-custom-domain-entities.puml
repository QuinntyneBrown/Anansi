@startuml
skinparam classAttributeIconSize 0
skinparam linetype ortho
hide empty methods

class BaseEntity <<abstract>> {
  +Id : Guid
  +CreatedAt : DateTime
  +UpdatedAt : DateTime
}

class CustomDomain {
  +PhotographerId : Guid
  +DomainName : string
  +Purpose : DomainPurpose
  +IsVerified : bool
  +SslStatus : SslStatus
  +SslCertificateId : string?
  +SslExpiresAt : DateTime?
  +DnsInstructions : string?
  +VerificationToken : string?
  +VerifiedAt : DateTime?
}

class Photographer {
  +Subdomain : string
  +CustomGalleryDomain : string?
  +CustomWebsiteDomain : string?
}

enum DomainPurpose {
  Gallery
  Website
}

enum SslStatus {
  Pending
  Active
  Expired
  Failed
}

BaseEntity <|-- CustomDomain
BaseEntity <|-- Photographer
CustomDomain --> DomainPurpose
CustomDomain --> SslStatus
Photographer "1" --> "0..*" CustomDomain : Domains

@enduml
